# Chess Dad configuration. Copy to `.env.local` and adjust.

# --- Engine ---
# Path to the Stockfish binary (default: resolve `stockfish` on PATH).
STOCKFISH_PATH=stockfish
# Default analysis depth for game review (14 = fast, 18 = deep).
ANALYSIS_DEPTH=14
ENGINE_TIMEOUT_MS=60000
# Per-engine UCI options. Lower threads when running many workers.
ENGINE_THREADS=2
ENGINE_HASH_MB=64
# Stockfish process pool size (one engine per concurrent game).
# ENGINE_POOL_SIZE=5

# --- Analysis queue (the MQ) + worker pool ---
# How many games are analysed at once. Defaults to min(4, cpus - 1).
# WORKER_CONCURRENCY=4
# How often an idle worker polls the queue (ms).
# WORKER_POLL_MS=750
# Job lease before an unfinished job is reclaimed (ms).
# JOB_LEASE_MS=120000
# Attempts per job before it is marked failed.
# JOB_MAX_ATTEMPTS=2

# --- Import ---
MAX_GAMES_PER_SOURCE=100
# Optional: a Lichess OAuth token (personal API access token) raises rate limits
# and can fetch private games. Public games work without it.
LICHESS_TOKEN=

# --- LLM coaching (choose one) ---
# off      → deterministic, offline explanations grounded in the OKF bundle (default).
# deepseek → DeepSeek-V3.2 API.
# ollama   → a local model via Ollama (e.g. a fine-tuned Qwen3 chess coach).
LLM_PROVIDER=off

# DeepSeek (used when LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
# The installed default; a Qwen3-1.7B "chess coach" fine-tune is recommended.
OLLAMA_MODEL=gemma4

# --- Storage (local-first) ---
# CHESSDAD_DB_PATH=./data/chessdad.db
