# Keep the build context small and keep anything local, secret or generated out
# of the image. `COPY . .` in the Dockerfile build stage is filtered by this file.

# --- dependencies (reinstalled from the lockfile in the deps stage) ---------
node_modules
**/node_modules
.pnpm-store
.pnpm-debug.log

# --- build output (rebuilt inside the image) -------------------------------
.next
out
build
.turbo
next-env.d.ts
*.tsbuildinfo
coverage

# --- version control / agent tooling ---------------------------------------
.git
.gitignore
.github
.agents
.claude
.impeccable

# --- local runtime data -----------------------------------------------------
# IMPORTANT: data/ holds the real 18 MB development database. It must NEVER be
# baked into the image — the deployed app gets its database from the /data
# volume (CHESSDAD_DB_PATH), created empty on first boot.
data
# A locally installed engine is platform-specific; the image fetches its own.
engines

# --- environment / secrets (only the annotated example is safe) -------------
.env
.env.*
!.env.example

# --- tests ------------------------------------------------------------------
test
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# --- brand asset generator (sharp; only needed to regenerate the logo) ------
brand

# --- editor / OS noise ------------------------------------------------------
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
